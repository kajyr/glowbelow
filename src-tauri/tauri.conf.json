{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Glow Below",
  "version": "../package.json",
  "identifier": "com.nightdrops.glowbelow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "windows": [
      {
        "title": "Glow Below",
        "width": 1280,
        "height": 800,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A peaceful deep-sea game for young children",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
